# DEMO shows simulated, labeled routes. LIVE asks the configured providers only.
NEXT_PUBLIC_PORTAL_MODE=demo

# Optional. Without it only injected (browser) wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Enables Relay execution (quotes work without it, flagged "comparison only").
RELAY_API_KEY=
# RELAY_API_KEY_HEADER=x-api-key

# Optional RPC overrides (public endpoints are used otherwise).
# NEXT_PUBLIC_RPC_ETHEREUM=
# NEXT_PUBLIC_RPC_BASE=
# NEXT_PUBLIC_RPC_ARBITRUM=
# NEXT_PUBLIC_RPC_OPTIMISM=
# NEXT_PUBLIC_RPC_POLYGON=
# NEXT_PUBLIC_RPC_ROBINHOOD=
# NEXT_PUBLIC_EXPLORER_ROBINHOOD=https://robinhoodchain.blockscout.com

# $PORTAL token — none deployed. Utilities stay INACTIVE until set.
# NEXT_PUBLIC_PORTAL_TOKEN_ROBINHOOD=

# Canonical Arbitrum Orbit bridge — not configured.
# NEXT_PUBLIC_ORBIT_INBOX=

NEXT_PUBLIC_SITE_URL=https://portal.example
